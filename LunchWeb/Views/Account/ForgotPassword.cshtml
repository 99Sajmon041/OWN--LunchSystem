@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Zapomenuté heslo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Zapomenuté heslo</h2>
                    <p class="text-muted mb-4">
                        Zadejte svůj e-mail. Pokud účet existuje, pošleme vám odkaz pro obnovení hesla.
                    </p>

                    <form asp-action="ForgotPassword" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Odeslat instrukce</button>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success">Zpět na přihlášení</a>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-muted small mt-3 text-center">
                Bezpečnostní poznámka: Z bezpečnostních důvodů je hláška stejná, ať už účet existuje, nebo ne.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

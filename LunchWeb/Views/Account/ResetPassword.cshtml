@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Obnova hesla";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Obnova hesla</h2>
                    <p class="text-muted mb-4">
                        Nastavte si prosím nové heslo.
                    </p>

                    <form asp-action="ResetPassword" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="form-text">
                                Minimálně 6 znaků.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Změnit heslo</button>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success">Zpět na přihlášení</a>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-muted small mt-3 text-center">
                Po úspěšné změně budete přesměrováni na přihlášení a můžete se přihlásit novým heslem.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IEnumerable<CustomerViewModel>

@{
    ViewData["Title"] = "Správa uživatelů";
}

<h2 class="text-center mb-4 fw-bold">Správa uživatelů</h2>

<div class="text-center mb-3">
    <a asp-action="Create" class="btn btn-success fw-bold">
        + Přidat nového uživatele
    </a>
</div>

<div class="d-flex justify-content-center">
    <table class="table table-bordered table-hover text-center align-middle w-auto">
        <thead class="table-light">
            <tr>
                <th>Křestní jméno</th>
                <th>Příjmení</th>
                <th>E-mail</th>
                <th>Role</th>
                <th>Dospělý</th>
                <th>Aktivní účet</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>@(user.IsAdult ? "Plnoletý" : "Neplnoletý")</td>
                    <td>
                        @if (user.Active)
                        {
                            <i class="bi bi-check2 text-success fw-bold"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-lg text-danger fw-bold"></i>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-success me-1">Detail</a>
                        <a asp-action="Update" asp-route-id="@user.Id" class="btn btn-sm btn-warning me-1">Upravit</a>

                        <form asp-action="Delete"
                              asp-route-id="@user.Id"
                              method="post"
                              class="d-inline delete-form">
                        </form>

                        <a href="#" class="btn btn-sm btn-danger"
                           onclick="if (confirm('Opravdu chcete smazat uživatele: @user.FirstName @user.LastName?')) this.previousElementSibling.submit(); return false;">
                            Smazat
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

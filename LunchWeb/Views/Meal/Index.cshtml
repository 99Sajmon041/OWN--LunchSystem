@model List<MealViewModel>

@{
    ViewData["Title"] = "Správa obědů";
}

<h2 class="text-center mb-4 fw-bold">Správa obědů</h2>

<div class="d-flex justify-content-center mb-4">
    <a asp-action="Create" class="btn btn-success fw-bold">
        + Přidat nový oběd
    </a>
</div>

<div style="display: flex; justify-content: center;">
    <div style="width: 90%; max-width: 1400px;">
        <table class="table table-bordered table-hover align-middle w-100">
            <thead class="table-light text-center">
                <tr>
                    <th style="width: 10%;">Obrázek</th>
                    <th style="width: 15%;">Název jídla</th>
                    <th style="width: 45%;">Popis</th>
                    <th style="width: 10%;">Cena</th>
                    <th style="width: 20%;">Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var meal in Model)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@meal.ImageUrl" alt="@meal.FoodName"
                                 style="max-height: 60px; max-width: 100%; object-fit: cover;"
                                 class="img-thumbnail" />
                        </td>
                        <td>@meal.FoodName</td>
                        <td style="white-space: normal;">@meal.FoodDescription</td>
                        <td>@meal.Price.ToString("C")</td>
                        <td class="text-nowrap text-center">
                            <a asp-action="Details" asp-route-id="@meal.Id" class="btn btn-sm btn-success me-1">Detail</a>
                            <a asp-action="Update" asp-route-id="@meal.Id" class="btn btn-sm btn-warning me-1">Upravit</a>

                            <form asp-action="Delete"
                                  asp-route-id="@meal.Id"
                                  method="post"
                                  class="d-inline delete-form"></form>

                            <a href="#" class="btn btn-sm btn-danger"
                               onclick="if (confirm('Opravdu chcete smazat oběd: @meal.FoodName?')) this.previousElementSibling.submit(); return false;">
                                Smazat
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

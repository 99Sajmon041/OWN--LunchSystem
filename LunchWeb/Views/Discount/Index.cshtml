@model List<DiscountViewModel>
@{
    ViewData["Title"] = "Nastavení slevy pro Role";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <h2 class="text-center mb-4">Nastavení slevy pro Role:</h2>


            <div class="card shadow p-4 rounded-3">
                <form asp-action="Update" method="post">
                    @Html.AntiForgeryToken()

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:50%">Role</th>
                                    <th style="width:30%">Sleva (0 – 100 %)</th>
                                    <th class="text-end" style="width:20%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <input type="hidden" asp-for="@Model[i].RoleId" />
                                        <input type="hidden" asp-for="@Model[i].RoleName"/>
                                        <td class="fw-semibold">
                                            @Model[i].RoleName
                                        </td>
                                        <td style="max-width:220px;">
                                            <div class="input-group">
                                                <input asp-for="@Model[i].Discount"
                                                       type="number"
                                                       class="form-control"
                                                       step="1" min="0" max="100" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <span asp-validation-for="@Model[i].Discount" class="text-danger"></span>
                                        </td>
                                        <td class="text-end">
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Uložit</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
